# Copy to backend/.env (never commit real secrets)

# LLM provider keys — at least one required for live chat.
# If neither is set, the API runs in explicitly labeled scripted demo mode.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional model defaults (UI can override)
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-2.0-flash

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Use * for same-origin Vercel deploy; list localhost for local Vite proxy
CORS_ORIGINS=*,http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite) — leave empty on Vercel (same-origin /api). Locally Vite proxies /api.
VITE_API_BASE_URL=
