# Copy to backend/.env (never commit real secrets)

# --- LLM (optional; scripted demo works without) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-2.0-flash

# --- App / CORS ---
# Public site origin (no trailing slash). Used for OAuth redirects + cookies.
APP_BASE_URL=http://localhost:5173
# Explicit origins required for cookie auth (do not use * with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://personality-playground-tau.vercel.app
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Auth / allowlist ---
# Gate playground behind login/allowlist. Default false = open access.
# Re-enable later with AUTH_ENABLED=true (alias: AUTH_REQUIRED=true).
AUTH_ENABLED=false
# Postgres on Vercel (Neon etc.). Local default is in-memory SQLite.
DATABASE_URL=sqlite+pysqlite:///:memory:
SESSION_SECRET=replace-with-long-random-string
# Optional Fernet key for encrypting emails at rest (url-safe base64 32-byte key)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
ADMIN_EMAIL=sarangpramode1997@gmail.com
# One-time: set admin password when seed row has no password_hash.
# After success, delete this env var and redeploy.
BOOTSTRAP_TOKEN=

# Google Sign-In (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin notification for pending signups (optional — logs if unset)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@personality-playground.local

# Backend bind (local)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (Vite) — leave empty on Vercel (same-origin /api)
VITE_API_BASE_URL=
